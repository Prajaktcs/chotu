#!/usr/bin/env bash
# Test only what the pushed commits touch: Signal startup, Rust, and the Expo app.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
# shellcheck source=.githooks/changes.sh
. .githooks/changes.sh
require_just pre-push

zero="0000000000000000000000000000000000000000"
changed=""
everything=false
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: compare with where it left main.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ] || ! files="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
    everything=true # unknown base (e.g. a force push over unfetched commits)
    continue
  fi
  changed+="$files"$'\n'
done

if [ "$everything" = true ]; then
  groups="signal rust app"
else
  groups="$(printf '%s' "$changed" | change_groups)"
fi

for group in $groups; do
  case "$group" in
    signal) recipe=signal-test ;;
    rust) recipe=rust-test ;;
    app) recipe=app-test ;;
    *) continue ;;
  esac
  echo "pre-push: just $recipe"
  just "$recipe"
done
